# Copy to .env.local for local development. In production set these in your host's dashboard (e.g. Vercel).

# --- Site ---------------------------------------------------------------------
# Canonical public URL (used for sitemap, canonical links, emails and structured data)
NEXT_PUBLIC_SITE_URL=https://astareo.tech

# --- Database (REQUIRED in production) -----------------------------------------
# Any Postgres connection string. Free options: Neon (neon.tech), Supabase (supabase.com).
# Use the *pooled* connection string on serverless hosts. Leave empty in local dev to use embedded PGlite (./.data).
DATABASE_URL=

# --- Admin console (/admin) (REQUIRED) -------------------------------------------
ADMIN_EMAIL=you@astareo.com
# Generate with:  npm run admin:hash -- "a long unique password"   (paste the whole output line)
ADMIN_PASSWORD_HASH=
# Convenience for first local run only. Prefer ADMIN_PASSWORD_HASH in production.
# ADMIN_PASSWORD=
# Random string, at least 32 chars. Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# --- AI agent (Google Gemini, free tier) ---------------------------------------------
# Free key: https://aistudio.google.com/apikey   Verify with:  npm run ai:check
GEMINI_API_KEY=
# Optional. Default: gemini-flash-latest
GEMINI_MODEL=
# Optional safety cap on total chat messages per day (protects the free quota). Default: 600
CHAT_DAILY_LIMIT=600

# --- Email: choose ONE provider ---------------------------------------------------------
# Without a provider, forms and bookings still work but NO emails are sent (admin shows a warning).
#
# Option A - SMTP (simplest, free, works immediately). Example: Gmail with an App Password
#   1) Google Account > Security > turn on 2-Step Verification
#   2) Google Account > Security > App passwords > create one named "Astareo" (16 characters)
#   3) Fill the values below. Gmail allows ~500 emails/day. Other SMTP hosts (Brevo, Zoho, Mailgun) work too.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-address@gmail.com
SMTP_PASS=
# SMTP_SECURE=false          # true only for port 465
EMAIL_FROM=Astareo <your-address@gmail.com>
#
# Option B - Resend (100/day free). IMPORTANT: until you verify a domain at resend.com/domains,
# it can only deliver to your own account email, so visitors would not receive confirmations.
# RESEND_API_KEY=
# EMAIL_FROM=Astareo <hello@your-verified-domain.com>
#
# Verify after setup: sign in to /admin and press "Send test email".
# Where new-lead and booking notifications go (default: contact@astareo.com). Use an inbox you actually read.
NOTIFY_EMAIL=contact@astareo.com
